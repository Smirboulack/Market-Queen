// Windows icon resources.
//
// The lowest id wins for the executable itself (explorer, taskbar), so the full
// character is 1. The head is loaded at runtime and pushed onto the window as
// ICON_SMALL, which is what the title bar draws: at 16px the full body is an
// unreadable smudge, the face is not.

#define IDI_APP_FULL 1
#define IDI_APP_HEAD 2

IDI_APP_FULL ICON "icon-full.ico"
IDI_APP_HEAD ICON "icon-head.ico"
